# Copy this file to .env.local and fill in the values.

# --- Lead e-mails (required) -------------------------------------------
# Every form submission is e-mailed to reservationslandsinsight@gmail.com.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
SMTP_USER=reservationslandsinsight@gmail.com
SMTP_PASS=

# Optional overrides
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# ENQUIRY_TO_EMAIL=reservationslandsinsight@gmail.com

# --- Optional ----------------------------------------------------------
# Also send each lead as JSON to a webhook (Google Sheet, Zapier, CRM…)
# ENQUIRY_WEBHOOK_URL=
# Google Tag Manager container for Google Ads conversion tracking
# NEXT_PUBLIC_GTM_ID=GTM-NTZ2LFDD
